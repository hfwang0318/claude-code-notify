.DS_Store
.serena/

# Dependencies and build outputs
node_modules/
out/
dist/
release/
artifacts/

# Local logs and diagnostics
*.log
*.jsonl
*_err.txt

# Vendored UI/UX reference repository; not required at runtime
uiux_skill_repo/

# Local SSH/Docker test harness credentials generated by ssh-test/build.sh
ssh-test/id_ed25519
ssh-test/id_ed25519.pub
ssh-test/password.txt

# Python hook bytecode
__pycache__/
*.py[cod]

# Runtime tab task state (created next to the deployed hook)
claude_notify_tab_state.json

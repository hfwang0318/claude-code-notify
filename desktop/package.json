{
  "name": "claude-notify-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Claude Code approval notifications and remote deployment desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "demo": "electron-vite build && electron . --demo-popup",
    "capture": "electron-vite build && electron . --capture",
    "self-test": "electron-vite build && electron . --self-test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e:claude": "node scripts/e2e-claude.mjs",
    "test:all": "pnpm test && pnpm e2e:claude",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "pack:mac": "electron-vite build && electron-builder --mac dir",
    "start": "electron .",
    "local-app": "bash scripts/make-local-app.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "author": "Claude Notify"
}
